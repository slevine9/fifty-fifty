# Copy to .env for local dev (export these in your shell or use `node --env-file=.env server.js`)
PORT=3000

# Day boundary. Questions refresh at midnight in this timezone.
GAME_TIMEZONE=America/New_York

# Seconds allowed per question (enforced on the server)
QUESTION_TIME_LIMIT=15

# What goes into each day's chain: source:share, comma-separated. Shares are proportional;
# the chain length is their sum (40 below) unless you set QUESTIONS_PER_DAY.
#   opentdb  general trivia (Open Trivia DB)
#   flags    "Which country's flag is this?"           (picture)
#   dogs     "Which breed is this?"                    (picture)
#   wiki     landmark and animal photos from Wikipedia (picture)
#   versus   "Which country has more people / is bigger?"
#   history  "Which happened first?" from Wikipedia's On This Day
#   claude   Claude-written questions (needs ANTHROPIC_API_KEY)
#   seed     small offline fallback list
QUESTION_MIX=opentdb:14,flags:6,dogs:4,wiki:6,versus:6,history:4
# QUESTIONS_PER_DAY=40

# Where the SQLite file lives. On Render, point this at a persistent disk (e.g. /var/data)
DATA_DIR=./data

# Only needed if QUESTION_MIX includes "claude"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: protects POST /admin/regenerate
ADMIN_TOKEN=

# Optional: Google OAuth 2.0 ("Continue with Google" / Gmail sign-in)
# Create a Web application OAuth client in Google Cloud Console with authorized redirect URI:
#   http://localhost:3000/auth/google/callback  (and https://your-domain/auth/google/callback in prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit public base URL (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=
